@using RecipeApp.Models
@model EditRecipeBase

<div class="form-group mb-3">
    <label asp-for="Name" class="col-md-2 control-label"></label>
    <div class="col-md-10">
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
</div>

<div class="form-group mb-3">
    <label asp-for="Method" class="col-md-2 control-label"></label>
    <div class="col-md-10">
        <textarea asp-for="Method" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Method" class="text-danger"></span>
    </div>
</div>

<div class="form-group mb-3">
    <label asp-for="TimeToCookHrs" class="col-md-2 control-label"></label>
    <div class="col-md-10">
        <input asp-for="TimeToCookHrs" class="form-control" type="number" min="0" max="24" />
        <span asp-validation-for="TimeToCookHrs" class="text-danger"></span>
    </div>
</div>

<div class="form-group mb-3">
    <label asp-for="TimeToCookMins" class="col-md-2 control-label"></label>
    <div class="col-md-10">
        <input asp-for="TimeToCookMins" class="form-control" type="number" min="0" max="59" />
        <span asp-validation-for="TimeToCookMins" class="text-danger"></span>
    </div>
</div>

<div class="form-group mb-3">
    <div class="col-sm-offset-2 col-sm-10">
        <div class="checkbox form-check">
            <input asp-for="IsVegetarian" class="form-check-input" />
            <label asp-for="IsVegetarian" class="form-check-label control-label"></label>
            <span asp-validation-for="IsVegetarian" class="text-danger"></span>
        </div>
    </div>
</div>

<div class="form-group mb-3">
    <div class="col-sm-offset-2 col-sm-10">
        <div class="checkbox form-check">
            <input asp-for="IsVegan" class="form-check-input" />
            <label asp-for="IsVegan" class="form-check-label control-label"></label>
            <span asp-validation-for="IsVegan" class="text-danger"></span>
        </div>
    </div>
</div>

<div class="form-group mb-3">
    <label asp-for="Category" class="col-md-2 control-label"></label>
    <div class="col-md-10">
        <select asp-for="Category" class="form-control form-select">
            <option value="">-- เลือกประเภทอาหาร --</option>
            <option value="อาหารคาว">อาหารคาว</option>
            <option value="ของหวาน">ของหวาน</option>
            <option value="เครื่องดื่ม">เครื่องดื่ม</option>
            <option value="อาหารทานเล่น">อาหารทานเล่น</option>
        </select>
        <span asp-validation-for="Category" class="text-danger"></span>
    </div>
</div>