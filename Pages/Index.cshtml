@page
@model IndexModel
@{
    ViewData["Title"] = "Menus";
}

<!-- ฟอร์มตัวกรองเลือกหมวดหมู่อาหาร -->
<form method="get" class="row g-3 mb-3 align-items-center">
    <div class="col-auto">
        <label for="SearchCategory" class="col-form-label fw-bold">เลือกหมวดหมู่:</label>
    </div>
    <div class="col-auto">
        <select asp-for="SearchCategory" asp-items="Model.Categories" class="form-select">
            <option value="">-- ทั้งหมด --</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a asp-page="./Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped recipe">
        <thead>
            <tr>
                <th>Recipe</th>
                <th>Category</th>
                <th>TimeToCook</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var recipe in Model.Recipes)
            {
                <tr>
                    <td class="align-middle">@recipe.Name</td>
                    <td class="align-middle">
                        <span class="badge bg-secondary">@recipe.Category</span>
                    </td>
                    <td class="align-middle">@recipe.TimeToCook</td>
                    <td class="align-middle">
                        <a asp-page="Recipes/View" asp-route-id="@recipe.Id" class="btn btn-primary">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<a asp-page="Recipes/Create" class="btn btn-success">Create new Recipe</a>